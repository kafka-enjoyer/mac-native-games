# Copy to .signing.env (gitignored) for `just install-totk-ios <device>`.
# Use a SEPARATE Apple ID created only for signing these IPAs - never your personal Apple ID.

# Team ID of the dedicated signing Apple ID (Xcode > Settings > Accounts > team, or developer.apple.com > Membership).
MNG_SIGNING_TEAM=

# Team IDs that must never sign (e.g. your personal Apple ID's team), comma-separated.
MNG_SIGNING_FORBIDDEN_TEAMS=

# Optional (paid account): App Store Connect API key of the dedicated account. When set, xcodebuild authenticates with
# this key instead of any Apple ID signed in to Xcode. Leave all three empty to use the dedicated Apple ID added in Xcode.
MNG_SIGNING_KEY_PATH=
MNG_SIGNING_KEY_ID=
MNG_SIGNING_ISSUER_ID=
